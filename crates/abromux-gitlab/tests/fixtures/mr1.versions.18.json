      "a_mode": "0",
      "b_mode": "100644",
      "collapsed": false,
      "deleted_file": false,
      "diff": "@@ -0,0 +1,19 @@\n+use std::collections::HashMap;\n+\n+/// Allows each key at most `limit` times.\n+pub struct Limiter {\n+    limit: u32,\n+    seen: HashMap<String, u32>,\n+}\n+\n+impl Limiter {\n+    pub fn new(limit: u32) -> Self {\n+        Self { limit, seen: HashMap::new() }\n+    }\n+\n+    pub fn allow(&mut self, key: &str) -> bool {\n+        let n = self.seen.entry(key.to_string()).or_insert(0);\n+        *n += 1;\n+        *n <= self.limit\n+    }\n+}\n",
      "generated_file": false,
      "new_file": true,
      "new_path": "src/limiter.rs",
      "old_path": "src/limiter.rs",
      "renamed_file": false,
      "too_large": false
    },
    {
      "a_mode": "100644",
      "b_mode": "100644",
      "collapsed": false,
      "deleted_file": false,
      "diff": "@@ -1,11 +1,16 @@\n use std::collections::HashMap;\n \n mod config;\n+mod limiter;\n \n fn main() {\n     let cfg = config::load();\n+    let mut limiter = limiter::Limiter::new(cfg.limit);\n     let mut hits: HashMap<String, u32> = HashMap::new();\n     for line in std::io::stdin().lines().map_while(Result::ok) {\n+        if !limiter.allow(&line) {\n+            continue;\n+        }\n         *hits.entry(line).or_default() += 1;\n     }\n     println!(\"{} distinct keys, limit {}\", hits.len(), cfg.limit);\n",
